{
  "entities": {
    "system_meta": {
      "title": "SystemMeta",
      "description": "System metadata and health pings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "number" }
      }
    },
    "app_data": {
      "title": "AppData",
      "description": "Core serialized database store for persistent company and media data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "companies": {
      "title": "Company",
      "description": "Companies registered in the indoor media platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trade_name": { "type": "string" },
        "legal_name": { "type": "string" },
        "cnpj": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "users": {
      "title": "User",
      "description": "System user accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/system_meta/{metaId}": {
      "schema": "system_meta",
      "description": "System health and ping records"
    },
    "/app_data/{docId}": {
      "schema": "app_data",
      "description": "Core serialized database store for persistence"
    },
    "/companies/{companyId}": {
      "schema": "companies",
      "description": "Companies registered in the indoor media platform"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and credentials"
    }
  }
}
