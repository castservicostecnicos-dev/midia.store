# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PERSISTENCE (Render.com Persistent Disks or custom server paths)
# Caso utilize um Persistent Disk no Render.com ou volume persistente Docker (ex: /var/data),
# você pode definir estas variáveis no dashboard para persistir o banco e mídias entre deploys:
# DATA_DIR="/var/data"
# UPLOAD_DIR="/var/data/uploads"
# UPLOADS_DIR="/var/data/uploads"
# (No AI Studio ou ambiente padrão, caso não definidas, o sistema usa ./data e ./uploads locais com sincronização em nuvem via Firestore)

# FIREBASE FIRESTORE CLOUD PERSISTENCE
# NOTA: O applet já inclui o arquivo 'firebase-applet-config.json' na raiz do projeto com
# todas as credenciais ativas e funcionais para o Firestore.
# Você NÃO precisa preencher estas variáveis no AI Studio!
#
# Caso vá fazer deploy externo no Render.com sem incluir o arquivo JSON no repositório Git,
# você pode copiar e colar os seguintes valores nas variáveis de ambiente do Render:
# FIREBASE_PROJECT_ID="gen-lang-client-0937994667"
# FIREBASE_API_KEY="AIzaSyDvpq2UlfA9Oul9pzH85hMowaxUIvzZPMo"
# FIRESTORE_DATABASE_ID="ai-studio-mdiaindoor-0ee6f26d-4225-42ad-910a-5d51615f2900"
# FIREBASE_APP_ID="1:401181939221:web:68377d3f53140ee060e01c"
# FIREBASE_AUTH_DOMAIN="gen-lang-client-0937994667.firebaseapp.com"

# DECOUPLED STATIC SITE ARCHITECTURE (Opcional)
# Caso decida hospedar o Frontend como Static Site separado do Backend Node.js:
# VITE_API_BASE_URL="https://sua-api-backend.onrender.com/api"


